      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(hello_cost_milliseconds_sum{service_name=\"demo\"}[5m]) / rate(hello_cost_milliseconds_count{service_name=\"demo\"}[5m])",
